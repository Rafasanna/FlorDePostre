# Frontend: solo URLs públicas y selector de fuente, nunca secretos.
# Conservar las once URLs actuales de .env.local sin sobrescribirlas.
VITE_SHEET_MENU_URL=
VITE_SHEET_SIN_TACC_URL=
VITE_SHEET_POSTRES_URL=
VITE_SHEET_POSTRES_TAMANOS_URL=
VITE_SHEET_POSTRES_CONFIG_URL=
VITE_SHEET_CAMPANAS_URL=
VITE_SHEET_ESPECIALES_URL=
VITE_SHEET_TORTAS_TAMANOS_URL=
VITE_SHEET_TORTAS_COBERTURAS_URL=
VITE_SHEET_TORTAS_RELLENOS_URL=
VITE_SHEET_TORTAS_EXTRAS_URL=
VITE_CATALOG_SOURCE=sheets

# Demo: solo en vite serve, modo desarrollo, host loopback y fuera de Vercel.
# npm run dev:admin habilita esta opción localmente; build siempre la elimina.
ADMIN_DEMO_MODE=off

# Servidor: por defecto no se conecta ni permite operaciones reales.
ADMIN_ENABLED=false
ADMIN_WRITES_ENABLED=false
DATABASE_URL=
# Solo comprobación local: copiar hostname exacto del Connect de la rama de pruebas.
NEON_TEST_PROJECT=flor-de-postre-pruebas
NEON_TEST_BRANCH=production
NEON_TEST_HOST=
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=
CATALOG_SOURCE=sheets
CATALOG_NEON_APPROVED=false

# Solo servidor; preset SIGNED de imágenes JPG/PNG/WebP, límite 2 MB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Exclusivamente entorno TEMPORAL de CLI tras autorización, no en Vercel.
# ALLOW_DATABASE_WRITES=I_HAVE_APPROVAL
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
